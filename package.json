{
  "name": "blaajerv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --experimental-transform-types --test \"src/**/*.test.ts\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "audit": "npm audit --audit-level=moderate --omit=dev",
    "check": "npm run lint && npm run typecheck && npm run test && npm run audit && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unorsk/blaajerv.git"
  },
  "bugs": {
    "url": "https://github.com/unorsk/blaajerv/issues"
  },
  "homepage": "https://github.com/unorsk/blaajerv#readme",
  "dependencies": {
    "@atproto/oauth-client-browser": "^0.5.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "svelte": "^5.56.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
